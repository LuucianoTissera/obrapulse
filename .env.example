# Copiar a .env y completar. NUNCA commitear .env
# Sin ANTHROPIC_API_KEY el sistema funciona igual (modo ML + reglas, sin llamadas externas).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# hybrid = ML primero, escala a LLM los casos de baja confianza (recomendado)
# ml | llm | rules  = modos puros
CLASSIFIER_MODE=hybrid
CONFIDENCE_THRESHOLD=0.70
LLM_MAX_CALLS=200

# Si se define, la API exige el header X-API-Key
API_KEY=

OP_DATA_DIR=data/sample
OP_DB_PATH=data/runtime/obrapulse.db
OP_MODEL_PATH=models/classifier.joblib
OP_REPORTS_DIR=reports
LOG_LEVEL=INFO
